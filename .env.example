# ============================================
# Career-Pilot Environment Variables
# ============================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# ============================================

# --- LLM Configuration ---
# Groq (free tier, reliable fallback)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (set USE_GEMINI=true to prioritize over Groq)
GOOGLE_API_KEY=your_gemini_api_key_here
USE_GEMINI=false

# --- Search Engine ---
SERPER_API_KEY=your_serper_api_key_here

# --- Email Delivery (provide at least one) ---
# Method A: SendGrid (Recommended for Production)
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_SENDER=your_verified_email@domain.com

# Method B: Resend (Alternative)
# RESEND_API_KEY=your_resend_api_key_here

# Method C: Gmail SMTP (Local Dev Only)
# EMAIL_PASSWORD=your_gmail_app_password_here

# --- MCP Scraping Keys (Optional) ---
# APIFY_API_TOKEN=your_apify_token_here
# JINA_API_KEY=your_jina_key_here

# --- LangSmith Tracing (Optional) ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=your_langsmith_key_here
# LANGCHAIN_PROJECT=career-pilot
